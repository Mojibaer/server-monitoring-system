# Copy this file to supabase/.env and fill in real values.
#   cp supabase/.env.example supabase/.env
#
# The ANON_KEY and SERVICE_ROLE_KEY below are the well-known Supabase demo
# JWTs that match the demo JWT_SECRET. They are FINE for local development but
# MUST be regenerated for anything exposed beyond localhost.
# Generate matching keys at: https://supabase.com/docs/guides/self-hosting

# ── Postgres ─────────────────────────────────────────────────────────
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
POSTGRES_PORT=5432
POSTGRES_HOST=db

# ── JWT / API keys ───────────────────────────────────────────────────
JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
JWT_EXPIRY=3600

ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiIsImlzcyI6InN1cGFiYXNlLWRlbW8iLCJpYXQiOjE2NDE3NjkyMDAsImV4cCI6MTc5OTUzNTYwMH0.dc_X5iR_VP_qT0zsiyj_I_OZ2T9FtRU2BBNWN8Bu4GE
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoic2VydmljZV9yb2xlIiwiaXNzIjoic3VwYWJhc2UtZGVtbyIsImlhdCI6MTY0MTc2OTIwMCwiZXhwIjoxNzk5NTM1NjAwfQ.DaYlNEoUrrEn2Ig7tqibS-PHK5vgusbcbo7X36XVt4Q

# ── Gateway / public URL ─────────────────────────────────────────────
KONG_HTTP_PORT=8000
KONG_HTTPS_PORT=8443
SUPABASE_PUBLIC_URL=http://localhost:8000
PGRST_DB_SCHEMAS=public

# ── Dashboard (Kong basic-auth; only used if Studio is enabled) ───────
DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=supabase
STUDIO_PORT=3000

# Grafana
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin123
GRAFANA_DB_PASSWORD=grafana_password
