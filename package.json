{
  "dependencies": {
    "@grpc/grpc-js": "^1.13.4",
    "@grpc/proto-loader": "^0.8.0",
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "dev": "tsx src/server.ts",
    "dev:seed": "tsx src/server.ts --seed",
    "build": "tsc",
    "start": "node dist/server.js",
    "start:seed": "node dist/server.js --seed",
    "test": "node --import tsx --test src/**/*.test.ts",
    "supabase:up": "docker compose --env-file supabase/.env -f supabase/docker-compose.yml up -d",
    "supabase:down": "docker compose --env-file supabase/.env -f supabase/docker-compose.yml down",
    "supabase:status": "docker compose --env-file supabase/.env -f supabase/docker-compose.yml ps",
    "supabase:logs": "docker compose --env-file supabase/.env -f supabase/docker-compose.yml logs -f"
  }
}
